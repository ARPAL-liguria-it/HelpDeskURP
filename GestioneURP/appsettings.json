{
  "NLog": {
    "autoReload": false,
    "throwConfigExceptions": true,
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/Log/URP_Gestione.Log",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}",
        "archiveFileName": "${basedir}/Log/Archives/${shortdate}-{#}-URP_Gestione.log",
        "archiveEvery": "Day"
      },
      "logconsole": {
        "type": "Console",
        "layout": "${date:format=yyyy-MM-ddTHH\\:mm\\:ss.ffzzz}|${level:uppercase=true}|${logger}|${message:withexception=true}"
      },
      "mail": {
        "type": "Mail",
        "from": "XXX@YYY.it",
        "to": "XXX@YYY.it",
        "smtpServer": "x.y.it",
        "smtpPort": 587,
        "smtpAuthentication": "Basic",
        "smtpUserName": "XXX@YYY.it",
        "smtpPassword": "XXX",
        "enableSsl": true,
        "subject": "TEST Errore URP_Gestione TEST ${uppercase:${level}}",
        "html": true,
        "body": "<b>Data:</b> ${longdate}<br/><b>Logger:</b> ${logger}<br/><b>Messaggio:</b> ${message}<br/><pre>${exception:format=tostring}</pre>"
      },
    "rules": [
      {
        "logger": "Microsoft.*",
        "minLevel": "Trace",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile,logconsole"
      },
      {
        "logger": "*",
        "minLevel": "Error",
        "writeTo": "mail"
      }
    ]
  },
  "ConnectionStrings": {
    "StringaConnessioneDB": "User Id=URP_HD;Password=URP_HD;Data Source=host"
  },
  "AllowedHosts": "*",
  "CartellaTemporanea": "C:\\Temp\\Gestione_URP\\Temp",
  "CartellaAllegatiRichieste": "C:\\Temp\\URP_HD\\AllegatiRichieste",
  "CartellaAllegatiReclami": "C:\\Temp\\URP_HD\\AllegatiReclami",
  "EstensioniAllegati": [
    ".pdf",
    ".png",
    ".jpg",
    ".jpeg",
    ".doc",
    ".docx"
  ],
  "DimensioneMassimaAllegatoMB": 10,
  "NumeroMassimoAllegati": 10,
  "GsoWsBaseUrl": "https://localhost/gsows/",
  "IdentificativoApplicazione": "URP_Gestione",
  "QuestionariBaseUrl": "https://questionari.example.it",
  "Email": {
    "From": "xxx@yyy.it",
    "Bcc": "xxx@yyy.it",
    "SmtpServer": "x.y.it",
    "Port": "587",
    "Username": "xxx@yyy.it",
    "Password": "XXX",
    "TipoQuestionarioCodice": "TEST002"
  }
}
