@page "/reclamowizard"
@inject URP_HDContext urpDbContext
@inject NavigationManager NavigationManager

@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject PuliziaFileTemporaneiService PuliziaFileTemporaneiService

@rendermode InteractiveServer

<PageTitle>Nuovo reclamo</PageTitle>

<FluentLabel style="text-align: right; width: 100%; padding: 1em;">
    @operatore?.Nome @operatore?.Cognome
</FluentLabel>

@if (
    (State.Reclamo.ID_TIPO_RICHIESTA != 3)
    ||
    String.IsNullOrEmpty(HttpContextAccessor.HttpContext?.Session.GetString("Operatore"))
)
{
    // L'utente non è autenticato, manda alla home page
    NavigationManager.NavigateTo(NavigationManager.BaseUri);
}

<div style="
    width:100%;
    max-width:800px;
    margin:0 auto;
    padding:20px;
    box-sizing:border-box;">
    <h1 class="titolo_h1">@descrizioneTipoRichiestaSelezionata</h1>

    @if (State.Step == 1)
    {
        <ReclamoInserimentoDati State="State"
                                OnAvanti="StateHasChanged"
                                OnIndietro="StateHasChanged" />
    }
    else if (State.Step == 2)
    {
        <ReclamoAllegati State="State"
                         OnAvanti="StateHasChanged"
                         OnIndietro="StateHasChanged" />
    }
    else if (State.Step == 3)
    {
        <ReclamoRiepilogo State="State"
                          OnAvanti="StateHasChanged"
                          OnIndietro="StateHasChanged" />
    }
    else if (State.Step == 4)
    {
        <ReclamoConferma State="State" />
    }

</div>
@code {

}
