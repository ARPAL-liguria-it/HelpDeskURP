@page "/richiestawizard"
@inject URP_HDContext urpDbContext
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@inject IHttpContextAccessor HttpContextAccessor
@inject PuliziaFileTemporaneiService PuliziaFileTemporaneiService

<PageTitle>Nuova richiesta</PageTitle>

<FluentLabel style="text-align: right; width: 100%; padding: 1em;">
    @operatore?.Nome @operatore?.Cognome
</FluentLabel>

<div style="
    width:100%;
    max-width:800px;
    margin:0 auto;
    padding:20px;
    box-sizing:border-box;">

    <h1 class="titolo_h1">@descrizioneTipoRichiestaSelezionata</h1>

    @if (State.Step == 1)
    {
        <RichiestaInserimentoDati State="State"
                                  OnAvanti="StateHasChanged"
                                  OnIndietro="StateHasChanged" />
    }
    else if (State.Step == 2)
    {
        <RichiestaAllegati State="State"
                           OnAvanti="StateHasChanged"
                           OnIndietro="StateHasChanged" />
    }
    else if (State.Step == 3)
    {
        <RichiestaRiepilogo State="State"
                            OnAvanti="StateHasChanged"
                            OnIndietro="StateHasChanged" />
    }
    else if (State.Step == 4)
    {
        <RichiestaConferma State="State" />
    }

</div>
@code {

}
