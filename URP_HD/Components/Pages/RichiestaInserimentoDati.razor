@inject NavigationManager NavigationManager
@inject IDbContextFactory<URP_HDContext> DbFactory
@inject IJSRuntime JS

<h3>Dati della richiesta</h3>

<p>Compilare il seguente modulo.</p>

<FluentStack Orientation="Orientation.Vertical"
             VerticalGap="16"
             Style="width:100%;">

    <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false" Visible="@elencoErrori.Any()">
        @foreach (var errore in elencoErrori)
        {
            <div>@errore</div>
        }
    </FluentMessageBar>

    <FluentTextField @bind-Value=State.Richiesta.COGNOME_AUTORE Label="Cognome:" style="width: 100%;" Maxlength="200" ReadOnly="@cognomePrecompilato" Class="campo-readonly"></FluentTextField>
    <FluentTextField @bind-Value=State.Richiesta.NOME_AUTORE Label="Nome:" style="width: 100%;" Maxlength="200" ReadOnly="@nomePrecompilato" Class="campo-readonly"></FluentTextField>
    <FluentTextField @bind-Value=State.Richiesta.EMAIL_AUTORE Label="E-mail:" style="width: 100%;" Required="true" Maxlength="200" ReadOnly="@emailPrecompilato" Class="campo-readonly"></FluentTextField>
    <FluentTextField @bind-Value=State.Richiesta.PEC_AUTORE Label="PEC:" style="width: 100%;" Maxlength="200"></FluentTextField>
    <FluentTextField @bind-Value=State.Richiesta.TELEFONO_AUTORE Label="Telefono:" style="width: 100%;" Maxlength="200"></FluentTextField>

    <FluentSelect TOption="TIPI_AUTORE_RICHIESTA"
                  Items="@tipiAutoreRichiesta"
                  Label="Chi sono:"
                  @bind-Value="@tipoAutoreSelezionato"
                  OptionValue="@(t => t.ID_TIPO_AUTORE_RICHIESTA.ToString())"
                  OptionText="@(t => t.DESCRIZIONE_TIPO_AUTORE_RICHIESTA)"
                  Required="true"
                  Style="width:100%;">
    </FluentSelect>

    <FluentSelect TOption="TIPI_TEMATICA"
                  Items="@tipiTematica"
                  Label="Tematica:"
                  @bind-Value="tipoTematicaSelezionata"
                  OptionValue="@(t => t.ID_TIPO_TEMATICA.ToString())"
                  OptionText="@(t => t.DESCRIZIONE_TIPO_TEMATICA)"
                  Required="true"
                  Style="width:100%;">
    </FluentSelect>

    <FluentSelect TOption="TIPI_LUOGO"
                  Items="@tipiLuogo"
                  Label="Luogo:"
                  @bind-Value="@tipoLuogoSelezionato"
                  OptionValue="@(t => t.ID_TIPO_LUOGO.ToString())"
                  OptionText="@(t => t.DESCRIZIONE_TIPO_LUOGO)"
                  Required="true"
                  Style="width:100%;">
    </FluentSelect>

    @if (tipoLuogoSelezionato == "5")
    {
        <FluentAutocomplete TOption="V_ELENCO_COMUNI_PROV"
                            AutoComplete="off"
                            Autofocus="true"
                            Label="Comune:"
                            Width="100%"
                            MaxAutoHeight="@(AutoHeightElencoComuni ? "200px" : null)"
                            Placeholder="--- Selezionare un Comune ---"
                            OnOptionsSearch="@OnSearchComuneAsync"
                            ImmediateDelay="100"
                            Multiple="false"
                            MaximumSelectedOptions="1"
                            OptionText="@(item => item.DESC_COMUNE_PROVINCIA)"
                            @bind-SelectedOption=comuneSelezionato
                            @bind-SelectedOption:after="OnComuneSelezionato"
                            Required="@(State.Richiesta.ID_TIPO_LUOGO.ToString() == "5")" />
    }
    else
    {
        comuneSelezionato = null;
        State.Richiesta.COMUNE_LUOGO = null;
    }

    <FluentTextField @bind-Value=State.Richiesta.INDIRIZZO Label="Indirizzo:" style="width: 100%;" Maxlength="500"></FluentTextField>

    <FluentTextArea @bind-Value=State.Richiesta.TESTO Label="Testo della richiesta:" Rows="5" Style="width: 100%;" Required="true" Maxlength="3000"></FluentTextArea>

    <FluentLabel>* Campo obbligatorio</FluentLabel>

    Eventuali allegati potranno essere caricati al passaggio successivo.

    <FluentStack Orientation="Orientation.Horizontal"
                 HorizontalGap="16"
                 Style="margin-top:20px;">

        <FluentButton Appearance="Appearance.Neutral"
                      Type="ButtonType.Button"
                      @onclick="Annulla">
            Annulla
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      Type="ButtonType.Button"
                      @onclick="Avanti"
                      Disabled="@(State.Step == 4)">
            Continua
        </FluentButton>
    </FluentStack>

</FluentStack>


