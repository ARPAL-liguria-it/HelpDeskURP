{
  "AllowedHosts": "*",
  "NLog": {
    "autoReload": false,
    "throwConfigExceptions": true,
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/Log/URP_HD.Log",
        "layout": "${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}",
        "archiveFileName": "${basedir}/Log/Archives/${shortdate}-{#}-URP_HD.log",
        "archiveEvery": "Day"
      },
      "logconsole": {
        "type": "Console",
        "layout": "${date:format=yyyy-MM-ddTHH\\:mm\\:ss.ffzzz}|${level:uppercase=true}|${logger}|${message:withexception=true}"
      },
      "mail": {
        "type": "Mail",
        "from": "xxx@yyy.it",
        "to": "xxx@yyy.it",
        "smtpServer": "x.y.it",
        "smtpPort": 587,
        "smtpAuthentication": "Basic",
        "smtpUserName": "xxx@yyy.it",
        "smtpPassword": "XXX",
        "enableSsl": true,
        "subject": "TEST Errore URP_HD TEST ${uppercase:${level}}",
        "html": true,
        "body": "<b>Data:</b> ${longdate}<br/><b>Logger:</b> ${logger}<br/><b>Messaggio:</b> ${message}<br/><pre>${exception:format=tostring}</pre>"
      },
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "minLevel": "Trace",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile,logconsole"
      },
      {
        "logger": "*",
        "minLevel": "Error",
        "writeTo": "mail"
      }
    ]
  },
  "StringaConnessioneDB": "user id=URP_HD;password=URP_HD;data source=host",
  "CartellaTemporanea": "C:\\Temp\\URP_HD\\Temp",
  "CartellaAllegatiRichieste": "C:\\Temp\\URP_HD\\AllegatiRichieste",
  "CartellaAllegatiReclami": "C:\\Temp\\URP_HD\\AllegatiReclami",
  "EstensioniAllegati": ".doc, .docx, .png, .jpg, .jpeg, .pdf",
  "URLPrivacy": "https://www.x.y.it/privacy.html",
  "URLAmministrazioneTrasparente": "https://x.y.it",
  "Email": {
    "From": "xxx@yyy.it",
    "Bcc": "",
    "DestinatarioURP": "xxx@yyy.it",
    "SmtpServer": "x.y.it",
    "Port": "587",
    "Username": "xxx@yyy.it",
    "Password": "XXX"
  },
  "HeaderAutenticazione": {
    "Email": "X-email",
    "Nome": "x-name",
    "Cognome": "X-familyName"
  }
}
