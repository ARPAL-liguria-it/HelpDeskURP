@page "/questionario/personale/{token}"
@using QuestionariURP.Application.Services
@inject QuestionarioAccessResolver AccessResolver
@inject IConfiguration Configuration

@if (AccessResolver.ErroreAccesso is not null)
{
    <div class="error-container">
        <h1>Errore di accesso</h1>
        <p>@AccessResolver.ErroreAccesso</p>
    </div>
}
else if (AccessResolver.TipoQuestionarioRisolto is not null)
{
    <QuestionarioCompilazione TipoQuestionario="@AccessResolver.TipoQuestionarioRisolto"
                               Sorgente="@AccessResolver.SorgenteRisolta"
                               Token="@AccessResolver.TokenVerificato" />
}
else
{
    <p>Caricamento...</p>
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            AccessResolver.ErroreAccesso = "Token mancante nell'URL.";
            return;
        }

        await AccessResolver.RisolviAccessoPersonaleAsync(Token);
    }
}
