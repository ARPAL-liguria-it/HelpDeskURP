        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin: 2rem 0;
    }

    .link-section {
        border: 1px solid #ddd;
        padding: 1.5rem;
        border-radius: 4px;
        background-color: #f9f9f9;
    }

    .link-section h3 {
        margin-top: 0;
    }

    .link-section code {
        display: block;
        background-color: #f0f0f0;
        padding: 0.5rem;
        border-radius: 3px;
        margin: 0.5rem 0;
        font-size: 0.9rem;
        overflow-x: auto;
    }

    .test-link {
        display: inline-block;
        margin-top: 0.5rem;
        padding: 0.5rem 1rem;
        background-color: #1976d2;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        transition: background-color 0.2s;
    }

    .test-link:hover {
        background-color: #1565c0;
    }

    .info-box {
        background-color: #e3f2fd;
        border-left: 4px solid #1976d2;
