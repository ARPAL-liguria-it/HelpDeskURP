@page "/questionario/libero"
@using QuestionariURP.Application.Services
@inject QuestionarioAccessResolver AccessResolver
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

@if (AccessResolver.ErroreAccesso is not null)
{
    <div class="error-container">
        <h1>Errore di accesso</h1>
        <p>@AccessResolver.ErroreAccesso</p>
    </div>
}
else if (AccessResolver.TipoQuestionarioRisolto is not null)
{
    <QuestionarioCompilazione TipoQuestionario="@AccessResolver.TipoQuestionarioRisolto"
                               Sorgente="@AccessResolver.SorgenteRisolta"
                               Token="@AccessResolver.TokenVerificato" />
}
else
{
    <p>Caricamento...</p>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        var query = new Uri(NavigationManager.Uri).Query;
        var queryParams = System.Web.HttpUtility.ParseQueryString(query);

        var sorgente = queryParams["sorgente"];
        var codice = queryParams["codice"];

        if (string.IsNullOrWhiteSpace(sorgente) || string.IsNullOrWhiteSpace(codice))
        {
            AccessResolver.ErroreAccesso = "Parametri URL mancanti (sorgente, codice richiesti).";
            return;
        }

        await AccessResolver.RisolviAccessoLiberoAsync(sorgente, codice);
    }
}
