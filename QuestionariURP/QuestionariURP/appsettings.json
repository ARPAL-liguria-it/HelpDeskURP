{
  "ConnectionStrings": {
    "Oracle": "User Id=URP_HD;Password=URP_HD;Data Source=host"
  },
  "NLog": {
    "autoReload": false,
    "throwConfigExceptions": true,
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/Log/URP_Questionari.Log",
        "layout": "${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}",
        "archiveFileName": "${basedir}/Log/Archives/${shortdate}-{#}-URP_Questionari.log",
        "archiveEvery": "Day"
      },
      "logconsole": {
        "type": "Console",
        "layout": "${date:format=yyyy-MM-ddTHH\\:mm\\:ss.ffzzz}|${level:uppercase=true}|${logger}|${message:withexception=true}"
      },
      "mail": {
        "type": "Mail",
        "from": "xxx@yyy.it",
        "to": "xxx@yyy.it",
        "smtpServer": "x.y.it",
        "smtpPort": 587,
        "smtpAuthentication": "Basic",
        "smtpUserName": "xxx@yyy.it",
        "smtpPassword": "XXX",
        "enableSsl": true,
        "subject": "TEST Errore URP_Questionari TEST ${uppercase:${level}}",
        "html": true,
        "body": "<b>Data:</b> ${longdate}<br/><b>Logger:</b> ${logger}<br/><b>Messaggio:</b> ${message}<br/><pre>${exception:format=tostring}</pre>"
      },
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "minLevel": "Trace",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile,logconsole"
      },
      {
        "logger": "*",
        "minLevel": "Error",
        "writeTo": "mail"
      }
    ]
  },
  "AllowedHosts": "*",
  "CartellaTemporanea": "C:\\Temp\\QuestionariURP\\Temp"
}
